<Window x:Class="HostDeviceControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HostDeviceControl.App.Controls"
        Title="Host-Device Control PoC"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="4" Text="Transport" />
                <ComboBox ItemsSource="{Binding ConnectionModes}"
                          SelectedItem="{Binding SelectedConnectionMode}" />

                <TextBlock Margin="12,4,4,4" Text="COM Port" />
                <ComboBox ItemsSource="{Binding PortNames}"
                          SelectedItem="{Binding SelectedPortName}"
                          IsEnabled="{Binding IsSerialMode}" />
                <Button Command="{Binding RefreshPortsCommand}"
                        Content="Refresh Ports"
                        IsEnabled="{Binding IsSerialMode}" />

                <TextBlock Margin="12,4,4,4" Text="Baud" />
                <TextBox Width="90"
                         Margin="4"
                         Padding="6"
                         Text="{Binding BaudRate}"
                         IsEnabled="{Binding IsSerialMode}" />

                <Button Command="{Binding ConnectCommand}" Content="Connect" />
                <Button Command="{Binding DisconnectCommand}" Content="Disconnect" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Padding="10"
                Background="#F4F6F8"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Device" />
                    <TextBlock Text="{Binding DeviceSummary}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Session" />
                    <TextBlock Text="{Binding SessionState}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Frames / Samples" />
                    <TextBlock>
                        <Run Text="{Binding ReceivedFrameCount}" />
                        <Run Text=" / " />
                        <Run Text="{Binding ReceivedSampleCount}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock FontWeight="SemiBold" Text="CRC / Lost" />
                    <TextBlock>
                        <Run Text="{Binding CrcErrorCount}" />
                        <Run Text=" / " />
                        <Run Text="{Binding LostSampleCount}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="8"
                Background="#101820"
                BorderBrush="#303840"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="4"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Text="Telemetry waveform — latest 10 seconds at 200 Hz" />
                <controls:WaveformControl Grid.Row="1"
                                          Margin="4"
                                          Samples="{Binding ChartSamples}"
                                          MinimumValue="-1.2"
                                          MaximumValue="1.2" />
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,8,0,8">
            <Button Command="{Binding StartStreamCommand}" Content="Start Stream" />
            <Button Command="{Binding StopStreamCommand}" Content="Stop Stream" />
            <Button Command="{Binding ClearChartCommand}" Content="Clear Chart" />
            <Separator Width="16" Opacity="0" />
            <Button Command="{Binding StartRecordingCommand}" Content="Start Recording" />
            <Button Command="{Binding StopRecordingCommand}" Content="Stop Recording" />
            <TextBlock Margin="12,4,4,4" Text="Recording:" />
            <TextBlock Margin="4"
                       FontWeight="SemiBold"
                       Text="{Binding RecordingStatus}" />
        </WrapPanel>

        <GroupBox Grid.Row="4" Header="Operational log">
            <ListBox ItemsSource="{Binding LogEntries}"
                     FontFamily="Consolas"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </GroupBox>

        <StatusBar Grid.Row="5" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Device tick: " />
                    <Run Text="{Binding LatestDeviceTickUs}" />
                    <Run Text=" us" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Recorder drops: " />
                    <Run Text="{Binding RecorderDropCount}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
