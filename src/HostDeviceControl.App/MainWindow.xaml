<Window x:Class="HostDeviceControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HostDeviceControl.App.Controls"
        mc:Ignorable="d"
        Title="Host-Device Control PoC"
        Width="1160"
        Height="780"
        MinWidth="920"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="145" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                BorderBrush="#D0D4D8"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Transport" />
                <ComboBox Width="130"
                          Margin="0,0,16,0"
                          AutomationProperties.Name="Transport mode"
                          IsEnabled="{Binding IsConnectionConfigurationEditable, Mode=OneWay}"
                          ItemsSource="{Binding ConnectionModes, Mode=OneWay}"
                          SelectedItem="{Binding SelectedConnectionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="COM Port" />
                <ComboBox Width="130"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="COM port"
                          IsEnabled="{Binding IsSerialConfigurationEditable, Mode=OneWay}"
                          ItemsSource="{Binding PortNames, Mode=OneWay}"
                          SelectedItem="{Binding SelectedPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button MinWidth="96"
                        Margin="0,0,16,0"
                        AutomationProperties.Name="Refresh serial ports"
                        Command="{Binding RefreshPortsCommand}"
                        Content="Refresh Ports" />

                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Baud" />
                <ComboBox Width="100"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Serial baud rate"
                          IsEnabled="{Binding IsSerialConfigurationEditable, Mode=OneWay}"
                          ItemsSource="{Binding BaudRates, Mode=OneWay}"
                          SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Width="145"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Text="{Binding StreamCapabilitySummary, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <Button MinWidth="92"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Connect device"
                        Command="{Binding ConnectCommand}"
                        Content="Connect" />
                <Button MinWidth="92"
                        AutomationProperties.Name="Disconnect device"
                        Command="{Binding DisconnectCommand}"
                        Content="Disconnect" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Padding="10"
                Background="#F2F4F6"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Device" />
                    <TextBlock Text="{Binding DeviceSummary, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Session" />
                    <TextBlock Text="{Binding SessionState, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Frames / Samples" />
                    <TextBlock>
                        <Run Text="{Binding ReceivedFrameCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding ReceivedSampleCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock FontWeight="SemiBold" Text="CRC / Format / Partial / Unknown" />
                    <TextBlock>
                        <Run Text="{Binding CrcErrorCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding FormatErrorCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding PartialFrameTimeoutCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding UnknownMessageTypeCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock FontWeight="SemiBold" Text="Lost / UI Drops" />
                    <TextBlock>
                        <Run Text="{Binding LostSampleCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding UiDropCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#101820"
                BorderBrush="#263746"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <TextBlock Margin="12,10,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Panel.ZIndex="1"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Text="Telemetry waveform — bounded UI buffer, 50 ms batching" />
                <controls:WaveformControl Margin="12,36,12,12"
                                          AutomationProperties.Name="Telemetry waveform"
                                          Samples="{Binding ChartSamples, Mode=OneWay}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="4,12,4,10"
                    Orientation="Horizontal">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Command="{Binding StartStreamCommand}"
                    Content="Start Stream" />
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Command="{Binding StopStreamCommand}"
                    Content="Stop Stream" />
            <Button MinWidth="100"
                    Margin="0,0,24,0"
                    Command="{Binding ClearChartCommand}"
                    Content="Clear Chart" />
            <Button MinWidth="114"
                    Margin="0,0,8,0"
                    Command="{Binding StartRecordingCommand}"
                    Content="Start Recording" />
            <Button MinWidth="114"
                    Margin="0,0,16,0"
                    Command="{Binding StopRecordingCommand}"
                    Content="Stop Recording" />
            <TextBlock VerticalAlignment="Center" Text="Recording:" />
            <TextBlock Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding RecordingStatus, Mode=OneWay}" />
        </StackPanel>

        <GroupBox Grid.Row="4" Header="Operational log">
            <ListBox Margin="4"
                     AutomationProperties.Name="Operational log"
                     FontFamily="Consolas"
                     FontSize="12"
                     ItemsSource="{Binding LogEntries, Mode=OneWay}"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />
        </GroupBox>

        <Border Grid.Row="5"
                Margin="0,6,0,0"
                Padding="4"
                Background="#F0EEEE">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" />
                <Separator Margin="8,0" />
                <TextBlock Text="Device tick:" />
                <TextBlock Margin="4,0,0,0" Text="{Binding LatestDeviceTickUs, Mode=OneWay}" />
                <TextBlock Margin="4,0,0,0" Text="us" />
                <Separator Margin="8,0" />
                <TextBlock Text="UI queue:" />
                <TextBlock Margin="4,0,0,0" Text="{Binding UiQueueDepth, Mode=OneWay}" />
                <Separator Margin="8,0" />
                <TextBlock Text="Recorder drops:" />
                <TextBlock Margin="4,0,0,0" Text="{Binding RecorderDropCount, Mode=OneWay}" />
                <Separator Margin="8,0" />
                <TextBlock Text="Log drops:" />
                <TextBlock Margin="4,0,0,0" Text="{Binding DiagnosticDropCount, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
